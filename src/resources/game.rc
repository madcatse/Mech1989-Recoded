#include <windows.h>
#include "game_resource.h"

IDI_MW1989 ICON "mw1989.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,0,0
 PRODUCTVERSION 0,6,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Mech1989: Recoded"
            VALUE "FileVersion", "0.6.0.0"
            VALUE "InternalName", "Mech1989"
            VALUE "OriginalFilename", "Mech1989.exe"
            VALUE "ProductName", "Mech1989: Recoded"
            VALUE "ProductVersion", "0.6 Beta"
            VALUE "Comments", "Unofficial native recreation of MechWarrior (1989). Original game data required."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
